<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color_defaultbackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Municipalities in China"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/color_textdark"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:src="@drawable/chinese_municipalities"
        android:scaleType="centerInside"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/prompt_text"
        android:textSize="18sp"
        android:textColor="@color/color_textdark"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etMunicipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_text"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionGo"
        android:backgroundTint="@color/color_textdark"
        android:textColor="@color/color_textdark"/>

</LinearLayout>